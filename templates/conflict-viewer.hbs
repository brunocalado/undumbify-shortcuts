{{#*inline "groupHeader"}}
<header>
    <kbd class="us-combo">{{group.comboDisplay}}</kbd>
    {{#if (eq group.tier "core")}}
    <span class="us-tier us-tier-core" data-tooltip
          aria-label="One of these is a Foundry control. Pressing the key runs them in the order shown, and Foundry only stops when one claims it.">Foundry</span>
    {{else}}
    <span class="us-tier" data-tooltip
          aria-label="Only modules or the system. Packages often share a key on purpose, each acting in its own situation.">Packages</span>
    {{/if}}
    <span class="group-count">{{group.actions.length}} actions, in run order</span>
    {{#if canIgnore}}
    {{#if group.ignored}}
    <button type="button" class="us-group-toggle" data-action="restoreGroup" data-tooltip
            aria-label="Treat this as a conflict again">
        <i class="fa-solid fa-eye" inert></i>
        <span>Restore</span>
    </button>
    {{else}}
    <button type="button" class="us-group-toggle" data-action="ignoreGroup" data-tooltip
            aria-label="These act in different situations — stop flagging this for everyone. It comes back if another action joins.">
        <i class="fa-solid fa-eye-slash" inert></i>
        <span>Can Coexist</span>
    </button>
    {{/if}}
    {{/if}}
</header>
{{/inline}}

{{#*inline "claimInfo"}}
<span class="us-position">{{action.position}}</span>
<div class="claim-info">
    <span class="action-label" data-tooltip aria-label="{{action.actionId}}">{{action.label}}</span>
    <span class="action-package">{{action.packageTitle}}{{#if action.bindingDisplay}}
        <span class="us-binding-note">· bound to {{action.bindingDisplay}}, fires with {{action.extraModifiers}} held too</span>{{/if}}</span>
</div>
{{/inline}}

<div class="viewer">
    <header class="toolbar">
        {{#if count}}
        <span class="summary conflicts">
            <i class="fa-solid fa-triangle-exclamation" inert></i>
            <span>{{count}} Conflict{{#unless (eq count 1)}}s{{/unless}}</span>
        </span>
        {{else}}
        <span class="summary clear">
            <i class="fa-solid fa-circle-check" inert></i>
            <span>No Conflicts</span>
        </span>
        {{/if}}

        <div class="toolbar-actions">
            <div class="us-sync-group">
                {{#if canSync}}
                <label class="us-sync-toggle">
                    <input type="checkbox" name="sync" {{checked syncEnabled}}>
                    <span class="us-toggle-track"><span class="us-toggle-thumb"></span></span>
                </label>
                <span class="us-sync-label">Sync</span>
                <i class="fa-solid fa-circle-question us-sync-help" data-tooltip
                   aria-label="While on, every connected user's keybindings mirror yours live — actions you have never customized are left as each player set them, and this updates automatically on every edit, not just resolutions made here."></i>
                {{else}}
                <i class="fa-solid {{#if syncEnabled}}fa-arrows-rotate{{else}}fa-link-slash{{/if}}" inert></i>
                <span class="us-sync-label">Sync {{#if syncEnabled}}On{{else}}Off{{/if}}</span>
                <i class="fa-solid fa-circle-question us-sync-help" data-tooltip
                   aria-label="Controlled by the GM. While on, your keybindings mirror the GM's automatically for any action the GM has customized."></i>
                {{/if}}
            </div>
            <span class="us-toolbar-separator"></span>
            <button type="button" data-action="openControls">
                <i class="fa-solid fa-gamepad" inert></i>
                <span>Controls Configuration</span>
            </button>
        </div>
    </header>

    <div class="conflicts scrollable">
    {{#if count}}
    <ol class="conflict-list">
        {{#each groups as |group|}}
        <li class="conflict-group tier-{{group.tier}}" data-combo="{{group.combo}}">
            {{> groupHeader group=group canIgnore=@root.canIgnore}}
            <ul class="claims">
                {{#each group.actions as |action|}}
                <li class="claim" data-action-id="{{action.actionId}}" data-index="{{action.index}}"
                    data-binding-combo="{{action.bindingCombo}}">
                    {{> claimInfo action=action}}
                    <div class="claim-controls">
                        <button type="button" data-action="keepThis" data-tooltip
                                aria-label="Keep this one, removing the other claims on this combination">
                            <i class="fa-solid fa-crown" inert></i>
                        </button>
                        {{#if action.editable}}
                        <button type="button" data-action="rebindClaim" data-tooltip aria-label="Rebind it here">
                            <i class="fa-solid fa-pen-to-square" inert></i>
                        </button>
                        <button type="button" data-action="clearClaim" data-tooltip aria-label="Remove this binding">
                            <i class="fa-solid fa-trash" inert></i>
                        </button>
                        {{else}}
                        <span class="us-locked" data-tooltip aria-label="This binding is locked by its package">
                            <i class="fa-solid fa-lock" inert></i>
                        </span>
                        {{/if}}
                        <button type="button" data-action="gotoClaim" data-tooltip aria-label="Go to this action">
                            <i class="fa-solid fa-arrow-right" inert></i>
                        </button>
                    </div>
                </li>
                {{/each}}
            </ul>
        </li>
        {{/each}}
    </ol>
    {{else}}
    <div class="empty">
        <i class="fa-solid fa-circle-check" inert></i>
        <p>No keybinding conflict needs attention.</p>
    </div>
    {{/if}}

    {{#if ignored.length}}
    <details class="ignored">
        <summary>
            <i class="fa-solid fa-eye-slash" inert></i>
            <span>Ignored — able to coexist ({{ignored.length}})</span>
        </summary>
        <ol class="conflict-list">
            {{#each ignored as |group|}}
            <li class="conflict-group is-ignored" data-combo="{{group.combo}}">
                {{> groupHeader group=group canIgnore=@root.canIgnore}}
                <ul class="claims">
                    {{#each group.actions as |action|}}
                    <li class="claim">{{> claimInfo action=action}}</li>
                    {{/each}}
                </ul>
            </li>
            {{/each}}
        </ol>
    </details>
    {{/if}}
    </div>
</div>
